PORT=3000
ADMIN_TOKEN=troque-isto

# Connection string do Postgres (obrigatório — o servidor recusa subir sem
# isso, ver src/db.js). Localmente, suba um Postgres descartável via Docker
# (5432 pode já estar ocupado por um Postgres do próprio sistema — ajuste a
# porta se precisar):
#   docker run -d --name forms-meta-pg -e POSTGRES_PASSWORD=postgres \
#     -e POSTGRES_DB=forms_meta -p 5434:5432 postgres:16-alpine
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/forms_meta

# SMTP pra notificar líderes de empresa por e-mail quando um colaborador
# preenche o DISC (ver src/email.js e src/notifications/discNotifier.js).
# Opcional — diferente de DATABASE_URL, o app funciona normalmente sem
# isso, só a notificação fica desligada (com um aviso no log). Protocolo
# SMTP genérico (nodemailer com host/porta/usuário/senha) de propósito —
# funciona com qualquer provedor/domínio, não é específico do Gmail.
# Exemplo abaixo usa Gmail/Google Workspace (host smtp.gmail.com, porta
# 587, secure=false/STARTTLS) só por ser o provedor da Tática — pra outro
# provedor, troque host/porta pelos dele. SMTP_USER/SMTP_PASS no caso do
# Gmail não é a senha normal da conta, precisa gerar uma "senha de app" em
# myaccount.google.com/apppasswords (contas com 2FA não aceitam
# autenticação SMTP básica com a senha normal).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=algum@taticacontabilidade.com
# SMTP_PASS=senha-de-app-gerada-no-google
# SMTP_FROM=algum@taticacontabilidade.com

# Robustez (ver CLAUDE.md) — todos opcionais, o padrão de cada um mantém o
# comportamento de hoje sem mudar nada:
#
# WEB_CONCURRENCY=1        número de processos worker (cluster). >1 só ajuda
#                          de verdade num plano com mais de 1 núcleo de CPU
#                          (o starter atual do Render não tem).
# PDF_WORKER_POOL_SIZE=2   quantas worker_threads ficam prontas gerando PDF
#                          em paralelo, fora da thread principal.
# DISABLE_RATE_LIMIT=true  desliga o rate limiting das rotas /api — só pra
#                          rodar scripts/loadtest.js localmente. NUNCA
#                          setar isso em produção.
