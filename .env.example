PORT=3000
ADMIN_TOKEN=troque-isto

# Robustez (ver CLAUDE.md) — todos opcionais, o padrão de cada um mantém o
# comportamento de hoje sem mudar nada:
#
# WEB_CONCURRENCY=1        número de processos worker (cluster). >1 só ajuda
#                          de verdade num plano com mais de 1 núcleo de CPU
#                          (o starter atual do Render não tem).
# PDF_WORKER_POOL_SIZE=2   quantas worker_threads ficam prontas gerando PDF
#                          em paralelo, fora da thread principal.
# DISABLE_RATE_LIMIT=true  desliga o rate limiting das rotas /api — só pra
#                          rodar scripts/load-test.js localmente. NUNCA
#                          setar isso em produção.
