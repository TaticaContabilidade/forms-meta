DJANGO_SECRET_KEY=troque-isto
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Mesma connection string do Postgres que o Node (../.env, DATABASE_URL) já
# usa — ver CLAUDE.md, "Deploy (Render) e persistência do banco". SSL liga
# sozinho quando o host bate com .render.com (ver config/settings.py).
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/forms_meta

# URL base do React — usada só pra montar o link de redefinição de senha
# mandado por e-mail (FRONTEND_URL + "/redefinir-senha?uid=...&token=...").
FRONTEND_URL=http://localhost:5173

# SMTP pra redefinição de senha (auth/esqueci-senha) — mesmas variáveis que
# o Node já usa (ver ../.env.example). Sem SMTP_HOST, cai no backend
# "console" do Django: o e-mail é só impresso no terminal do `runserver`,
# dá pra testar o fluxo localmente sem SMTP de verdade.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=algum@taticacontabilidade.com
# SMTP_PASS=senha-de-app-gerada-no-google
# SMTP_FROM=algum@taticacontabilidade.com
